load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":create-toolchain.bzl", "create_hocon_toolchain")

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

create_hocon_toolchain(
    name = "hocon-3",
    hocon_compiler = "//hocon-compiler-cli:hocon-compiler-cli-3",
)

bzl_library(
    name = "bzl",
    srcs = glob(["*.bzl"]),
    visibility = ["//visibility:public"],
)
